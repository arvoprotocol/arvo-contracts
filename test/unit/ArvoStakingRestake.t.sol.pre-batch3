// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import { Test } from "forge-std/Test.sol";
import { ERC1967Proxy } from "@openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol";

import { ArvoStaking } from "../../src/ArvoStaking.sol";
import { ArvoStakingTypes } from "../../src/ArvoStakingTypes.sol";
import { MockERC20 } from "../../src/mocks/MockERC20.sol";

contract ArvoStakingRestakeTest is Test {
    ArvoStaking internal staking;
    MockERC20 internal arvo;
    MockERC20 internal usdc;

    address internal admin = address(0xA11CE);
    address internal alice = address(0xB0B);

    uint32 internal foundationPool;

    uint256 internal constant USDC_STAKE = 10_000e6;
    uint256 internal constant FOUNDATION_USDC_REWARD = 1_600e6;
    uint256 internal constant BUILD_USDC_REWARD = 250e6;

    uint256 internal constant REWARD_BUDGET = 500_000e6;

    function setUp() public {
        arvo = new MockERC20("Arvo", "ARVO", 18);
        usdc = new MockERC20("USD Coin", "USDC", 6);

        ArvoStaking implementation = new ArvoStaking();

        bytes memory initialization =
            abi.encodeCall(ArvoStaking.initialize, (address(arvo), address(usdc), admin));

        ERC1967Proxy proxy = new ERC1967Proxy(address(implementation), initialization);

        staking = ArvoStaking(address(proxy));

        arvo.mint(admin, 10_000_000 ether);
        usdc.mint(admin, 10_000_000e6);

        vm.startPrank(admin);

        arvo.approve(address(staking), type(uint256).max);
        usdc.approve(address(staking), type(uint256).max);

        staking.fundArvoRewards(1_000_000 ether);
        staking.fundUsdcRewards(1_000_000e6);

        foundationPool = staking.createStandardPool(
            ArvoStakingTypes.VaultKind.FOUNDATION,
            uint64(block.timestamp + 1),
            0,
            50_000 ether,
            50_000e6,
            true,
            true,
            false,
            true,
            true
        );

        staking.reservePoolRewardBudget(foundationPool, 0, REWARD_BUDGET);

        vm.stopPrank();

        usdc.mint(alice, 100_000e6);

        vm.startPrank(alice);
        usdc.approve(address(staking), type(uint256).max);
        vm.stopPrank();

        vm.warp(block.timestamp + 1);
    }

    function _stakeFoundationUsdc() internal returns (uint256 positionId) {
        vm.prank(alice);

        positionId = staking.stake(
            foundationPool,
            ArvoStakingTypes.StakeMode.USDC,
            ArvoStakingTypes.RewardMode.USDC,
            0,
            USDC_STAKE
        );
    }

    function _warpToMaturity(uint256 positionId) internal {
        ArvoStakingTypes.Position memory userPosition = staking.position(positionId);

        vm.warp(userPosition.maturesAt);
    }

    function _createOpenBuildPool(uint256 maxUsdcPrincipal, uint256 rewardBudget)
        internal
        returns (uint32 poolId)
    {
        uint64 opensAt = uint64(block.timestamp + 1);

        vm.startPrank(admin);

        poolId = staking.createStandardPool(
            ArvoStakingTypes.VaultKind.BUILD,
            opensAt,
            0,
            0,
            maxUsdcPrincipal,
            false,
            true,
            false,
            false,
            true
        );

        staking.reservePoolRewardBudget(poolId, 0, rewardBudget);

        vm.stopPrank();

        vm.warp(opensAt);
    }

    function testRestakePrincipalSamePoolPaysRewardAndKeepsPrincipalStaked() public {
        uint256 oldPositionId = _stakeFoundationUsdc();

        ArvoStakingTypes.Position memory oldBefore = staking.position(oldPositionId);

        uint256 aliceBalanceBefore = usdc.balanceOf(alice);
        uint256 contractBalanceBefore = usdc.balanceOf(address(staking));

        uint256 principalLiabilityBefore = staking.usdcPrincipalLiability();

        _warpToMaturity(oldPositionId);

        vm.prank(alice);
        uint256 newPositionId = staking.restakePrincipal(
            oldPositionId, foundationPool, ArvoStakingTypes.RewardMode.USDC
        );

        /*
         * Only the completed cycle's reward returns to Alice.
         * Principal stays inside the staking contract.
         */
        assertEq(usdc.balanceOf(alice), aliceBalanceBefore + FOUNDATION_USDC_REWARD);

        assertEq(usdc.balanceOf(address(staking)), contractBalanceBefore - FOUNDATION_USDC_REWARD);

        assertEq(staking.usdcPrincipalLiability(), principalLiabilityBefore);

        assertEq(staking.vaultUsdcPrincipal(foundationPool), USDC_STAKE);

        ArvoStakingTypes.Position memory oldAfter = staking.position(oldPositionId);

        ArvoStakingTypes.Position memory newPosition = staking.position(newPositionId);

        assertTrue(oldAfter.settled);
        assertFalse(oldAfter.emergencyExit);
        assertEq(oldAfter.nextPositionId, newPositionId);

        assertEq(newPosition.previousPositionId, oldPositionId);
        assertFalse(newPosition.settled);
        assertFalse(newPosition.emergencyExit);

        assertEq(newPosition.owner, alice);
        assertEq(newPosition.vaultId, foundationPool);

        assertEq(uint256(newPosition.stakeMode), uint256(ArvoStakingTypes.StakeMode.USDC));

        assertEq(uint256(newPosition.rewardMode), uint256(ArvoStakingTypes.RewardMode.USDC));

        assertEq(newPosition.arvoPrincipal, 0);
        assertEq(newPosition.usdcPrincipal, USDC_STAKE);
        assertEq(newPosition.arvoReward, 0);
        assertEq(newPosition.usdcReward, FOUNDATION_USDC_REWARD);

        assertEq(newPosition.openedAt, oldAfter.settledAt);
        assertEq(newPosition.maturesAt, uint256(newPosition.openedAt) + 365 days);

        assertTrue(staking.isUsdcSolvent());
    }

    function testRestakePrincipalMovesPrincipalAccountingToDestinationPool() public {
        uint256 oldPositionId = _stakeFoundationUsdc();

        uint32 buildPool = _createOpenBuildPool(50_000e6, REWARD_BUDGET);

        _warpToMaturity(oldPositionId);

        uint256 principalLiabilityBefore = staking.usdcPrincipalLiability();

        vm.prank(alice);
        uint256 newPositionId =
            staking.restakePrincipal(oldPositionId, buildPool, ArvoStakingTypes.RewardMode.USDC);

        assertEq(staking.usdcPrincipalLiability(), principalLiabilityBefore);

        assertEq(staking.vaultUsdcPrincipal(foundationPool), 0);

        assertEq(staking.vaultUsdcPrincipal(buildPool), USDC_STAKE);

        ArvoStakingTypes.Position memory newPosition = staking.position(newPositionId);

        assertEq(newPosition.vaultId, buildPool);
        assertEq(newPosition.usdcPrincipal, USDC_STAKE);
        assertEq(newPosition.usdcReward, BUILD_USDC_REWARD);

        assertEq(newPosition.maturesAt, uint256(newPosition.openedAt) + 60 days);

        assertTrue(staking.isUsdcSolvent());
    }

    function testRestakeReplacesOldRewardLiabilityWithNewRewardLiability() public {
        uint256 oldPositionId = _stakeFoundationUsdc();

        uint32 buildPool = _createOpenBuildPool(50_000e6, REWARD_BUDGET);

        assertEq(staking.usdcRewardLiability(), FOUNDATION_USDC_REWARD);

        ArvoStakingTypes.PoolConfig memory destinationBefore = staking.pool(buildPool);

        uint256 globalReservedBefore = staking.usdcRewardBudgetReserved();

        _warpToMaturity(oldPositionId);

        vm.prank(alice);
        staking.restakePrincipal(oldPositionId, buildPool, ArvoStakingTypes.RewardMode.USDC);

        /*
         * The completed Foundation reward was paid out and removed
         * from committed liability. The new Build reward is now the
         * only committed reward liability.
         */
        assertEq(staking.usdcRewardLiability(), BUILD_USDC_REWARD);

        ArvoStakingTypes.PoolConfig memory destinationAfter = staking.pool(buildPool);

        assertEq(
            destinationAfter.usdcRewardBudgetRemaining,
            destinationBefore.usdcRewardBudgetRemaining - BUILD_USDC_REWARD
        );

        assertEq(staking.usdcRewardBudgetReserved(), globalReservedBefore - BUILD_USDC_REWARD);

        assertTrue(staking.isUsdcSolvent());
    }

    function testSamePoolRestakeSucceedsWhenPoolIsExactlyAtCapacity() public {
        /*
         * Create a separate pool whose entire public USDC capacity is
         * occupied by Alice's one position.
         */
        uint64 opensAt = uint64(block.timestamp + 1);

        vm.startPrank(admin);

        uint32 cappedPool = staking.createStandardPool(
            ArvoStakingTypes.VaultKind.BUILD,
            opensAt,
            0,
            0,
            USDC_STAKE,
            false,
            true,
            false,
            false,
            true
        );

        staking.reservePoolRewardBudget(cappedPool, 0, REWARD_BUDGET);

        vm.stopPrank();

        vm.warp(opensAt);

        vm.prank(alice);
        uint256 oldPositionId = staking.stake(
            cappedPool,
            ArvoStakingTypes.StakeMode.USDC,
            ArvoStakingTypes.RewardMode.USDC,
            0,
            USDC_STAKE
        );

        assertEq(staking.vaultUsdcPrincipal(cappedPool), USDC_STAKE);

        _warpToMaturity(oldPositionId);

        vm.prank(alice);
        uint256 newPositionId =
            staking.restakePrincipal(oldPositionId, cappedPool, ArvoStakingTypes.RewardMode.USDC);

        assertGt(newPositionId, oldPositionId);

        /*
         * The old commitment was replaced, not counted twice.
         */
        assertEq(staking.vaultUsdcPrincipal(cappedPool), USDC_STAKE);

        assertEq(staking.usdcPrincipalLiability(), USDC_STAKE);

        assertTrue(staking.isUsdcSolvent());
    }

    function testRestakeCreatesPositionLineageAndUserPositionHistory() public {
        uint256 oldPositionId = _stakeFoundationUsdc();

        _warpToMaturity(oldPositionId);

        vm.prank(alice);
        uint256 newPositionId = staking.restakePrincipal(
            oldPositionId, foundationPool, ArvoStakingTypes.RewardMode.USDC
        );

        ArvoStakingTypes.Position memory oldPosition = staking.position(oldPositionId);

        ArvoStakingTypes.Position memory newPosition = staking.position(newPositionId);

        assertEq(oldPosition.nextPositionId, newPositionId);
        assertEq(newPosition.previousPositionId, oldPositionId);

        uint256[] memory ids = staking.userPositionIds(alice);

        assertEq(ids.length, 2);
        assertEq(ids[0], oldPositionId);
        assertEq(ids[1], newPositionId);
    }

    function _assertPositionStillUnsettled(
        uint256 positionId,
        uint256 expectedPrincipal,
        uint256 expectedReward
    ) internal view {
        ArvoStakingTypes.Position memory userPosition = staking.position(positionId);

        assertFalse(userPosition.settled);
        assertFalse(userPosition.emergencyExit);
        assertEq(userPosition.settledAt, 0);
        assertEq(userPosition.nextPositionId, 0);
        assertEq(userPosition.usdcPrincipal, expectedPrincipal);
        assertEq(userPosition.usdcReward, expectedReward);
    }

    function _assertOriginalPositionStillClaimable(uint256 positionId) internal {
        _assertPositionStillUnsettled(positionId, USDC_STAKE, FOUNDATION_USDC_REWARD);

        uint256 balanceBefore = usdc.balanceOf(alice);

        vm.prank(alice);
        (uint256 arvoPaid, uint256 usdcPaid) = staking.claim(positionId);

        assertEq(arvoPaid, 0);
        assertEq(usdcPaid, USDC_STAKE + FOUNDATION_USDC_REWARD);

        assertEq(usdc.balanceOf(alice), balanceBefore + USDC_STAKE + FOUNDATION_USDC_REWARD);
    }

    function testCannotRestakeBeforeMaturityAndPositionRemainsUnchanged() public {
        uint256 positionId = _stakeFoundationUsdc();

        ArvoStakingTypes.Position memory beforeAttempt = staking.position(positionId);

        vm.warp(beforeAttempt.maturesAt - 1);

        vm.prank(alice);
        vm.expectRevert(ArvoStaking.PositionNotMatured.selector);

        staking.restakePrincipal(positionId, foundationPool, ArvoStakingTypes.RewardMode.USDC);

        _assertPositionStillUnsettled(positionId, USDC_STAKE, FOUNDATION_USDC_REWARD);

        assertEq(staking.usdcPrincipalLiability(), USDC_STAKE);

        assertEq(staking.usdcRewardLiability(), FOUNDATION_USDC_REWARD);
    }

    function testWrongOwnerCannotRestakeAndPositionRemainsClaimable() public {
        uint256 positionId = _stakeFoundationUsdc();

        _warpToMaturity(positionId);

        vm.prank(address(0xBAD));
        vm.expectRevert(ArvoStaking.NotPositionOwner.selector);

        staking.restakePrincipal(positionId, foundationPool, ArvoStakingTypes.RewardMode.USDC);

        _assertOriginalPositionStillClaimable(positionId);
    }

    function testCannotRestakeNonexistentPosition() public {
        vm.prank(alice);
        vm.expectRevert(ArvoStaking.InvalidPosition.selector);

        staking.restakePrincipal(
            type(uint256).max, foundationPool, ArvoStakingTypes.RewardMode.USDC
        );
    }

    function testCannotRestakeAlreadySettledPosition() public {
        uint256 positionId = _stakeFoundationUsdc();

        _warpToMaturity(positionId);

        vm.prank(alice);
        staking.claim(positionId);

        vm.prank(alice);
        vm.expectRevert(ArvoStaking.PositionAlreadySettled.selector);

        staking.restakePrincipal(positionId, foundationPool, ArvoStakingTypes.RewardMode.USDC);
    }

    function testPausedProtocolBlocksRestakeButClaimStillWorks() public {
        uint256 positionId = _stakeFoundationUsdc();

        _warpToMaturity(positionId);

        vm.prank(admin);
        staking.pause();

        assertTrue(staking.paused());

        /*
         * restakePrincipal() creates a new commitment and therefore
         * must be blocked by the protocol pause.
         *
         * We deliberately do not assert the OpenZeppelin custom-error
         * selector here because that selector belongs to the inherited
         * pause implementation rather than ArvoStaking itself.
         */
        vm.prank(alice);
        vm.expectRevert();

        staking.restakePrincipal(positionId, foundationPool, ArvoStakingTypes.RewardMode.USDC);

        _assertOriginalPositionStillClaimable(positionId);
    }

    function testClosedDestinationRejectsRestakeAndOldPositionRemainsClaimable() public {
        uint256 positionId = _stakeFoundationUsdc();

        uint32 buildPool = _createOpenBuildPool(50_000e6, REWARD_BUDGET);

        vm.prank(admin);
        staking.setPoolEnabled(buildPool, false);

        _warpToMaturity(positionId);

        vm.prank(alice);
        vm.expectRevert(ArvoStaking.PoolClosed.selector);

        staking.restakePrincipal(positionId, buildPool, ArvoStakingTypes.RewardMode.USDC);

        _assertOriginalPositionStillClaimable(positionId);
    }

    function testNotYetOpenDestinationRejectsRestakeAtomically() public {
        uint256 positionId = _stakeFoundationUsdc();

        uint64 opensAt = uint64(block.timestamp + 500 days);

        vm.prank(admin);
        uint32 futurePool = staking.createStandardPool(
            ArvoStakingTypes.VaultKind.BUILD,
            opensAt,
            0,
            0,
            50_000e6,
            false,
            true,
            false,
            false,
            true
        );

        vm.prank(admin);
        staking.reservePoolRewardBudget(futurePool, 0, REWARD_BUDGET);

        _warpToMaturity(positionId);

        assertLt(block.timestamp, opensAt);

        vm.prank(alice);
        vm.expectRevert(ArvoStaking.PoolNotOpen.selector);

        staking.restakePrincipal(positionId, futurePool, ArvoStakingTypes.RewardMode.USDC);

        _assertOriginalPositionStillClaimable(positionId);
    }

    function testDestinationCapacityExceededRejectsRestakeAtomically() public {
        uint256 positionId = _stakeFoundationUsdc();

        /*
         * Destination capacity is deliberately one unit below
         * Alice's existing principal.
         */
        uint32 buildPool = _createOpenBuildPool(USDC_STAKE - 1, REWARD_BUDGET);

        _warpToMaturity(positionId);

        vm.prank(alice);
        vm.expectRevert(ArvoStaking.CapacityExceeded.selector);

        staking.restakePrincipal(positionId, buildPool, ArvoStakingTypes.RewardMode.USDC);

        assertEq(staking.vaultUsdcPrincipal(buildPool), 0);

        _assertOriginalPositionStillClaimable(positionId);
    }

    function testInsufficientDestinationRewardBudgetRejectsRestakeAtomically() public {
        uint256 positionId = _stakeFoundationUsdc();

        /*
         * Build would owe 250 USDC on a 10,000 USDC principal.
         * Reserve one unit less than that requirement.
         */
        uint32 buildPool = _createOpenBuildPool(50_000e6, BUILD_USDC_REWARD - 1);

        ArvoStakingTypes.PoolConfig memory poolBefore = staking.pool(buildPool);

        uint256 reservedBefore = staking.usdcRewardBudgetReserved();

        _warpToMaturity(positionId);

        vm.prank(alice);
        vm.expectRevert(ArvoStaking.InsufficientPoolRewardBudget.selector);

        staking.restakePrincipal(positionId, buildPool, ArvoStakingTypes.RewardMode.USDC);

        ArvoStakingTypes.PoolConfig memory poolAfter = staking.pool(buildPool);

        assertEq(poolAfter.usdcRewardBudgetRemaining, poolBefore.usdcRewardBudgetRemaining);

        assertEq(staking.usdcRewardBudgetReserved(), reservedBefore);

        assertEq(staking.vaultUsdcPrincipal(buildPool), 0);

        _assertOriginalPositionStillClaimable(positionId);
    }
}
