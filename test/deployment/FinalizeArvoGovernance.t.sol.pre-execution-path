pragma solidity ^0.8.24;

import { Test } from "forge-std/Test.sol";
import { TimelockController } from "@openzeppelin/contracts/governance/TimelockController.sol";
import { ERC1967Proxy } from "@openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol";

import { FinalizeArvoGovernance } from "../../script/FinalizeArvoGovernance.s.sol";
import { ArvoStaking } from "../../src/ArvoStaking.sol";
import { MockERC20 } from "../../src/mocks/MockERC20.sol";

contract FinalizeArvoGovernanceTest is Test {
    uint256 internal constant DELAY = 48 hours;

    address internal deploymentAdmin = address(0xA11CE);
    address internal safe = address(0x5AFE);
    address internal emergency = address(0xE911);
    address internal outsider = address(0xBAD);

    ArvoStaking internal staking;
    TimelockController internal timelock;
    FinalizeArvoGovernance internal finalizer;

    function setUp() public {
        MockERC20 arvo =
            new MockERC20("Arvo", "ARVO", 18);

        MockERC20 usdc =
            new MockERC20("USD Coin", "USDC", 6);

        ArvoStaking implementation = new ArvoStaking();

        bytes memory initialization = abi.encodeCall(
            ArvoStaking.initialize,
            (address(arvo), address(usdc), deploymentAdmin)
        );

        ERC1967Proxy proxy =
            new ERC1967Proxy(address(implementation), initialization);

        staking = ArvoStaking(address(proxy));
        finalizer = new FinalizeArvoGovernance();

        address[] memory proposers = new address[](1);
        proposers[0] = safe;

        address[] memory executors = new address[](1);
        executors[0] = safe;

        timelock = new TimelockController(
            DELAY,
            proposers,
            executors,
            address(0)
        );
    }

    function _config()
        internal
        view
        returns (FinalizeArvoGovernance.GovernanceConfig memory)
    {
        return FinalizeArvoGovernance.GovernanceConfig({
            stakingProxy: address(staking),
            deploymentAdmin: deploymentAdmin,
            governanceSafe: safe,
            emergencyAuthority: emergency,
            timelock: address(timelock),
            timelockDelay: DELAY
        });
    }

    function _stageOne() internal {
        vm.startPrank(deploymentAdmin);

        staking.grantRole(
            staking.DEFAULT_ADMIN_ROLE(),
            address(timelock)
        );

        staking.grantRole(
            staking.UPGRADER_ROLE(),
            address(timelock)
        );

        staking.grantRole(
            staking.VAULT_MANAGER_ROLE(),
            safe
        );

        staking.grantRole(
            staking.REWARD_MANAGER_ROLE(),
            safe
        );

        staking.grantRole(
            staking.PAUSER_ROLE(),
            emergency
        );

        vm.stopPrank();
    }

    function _renounceDeploymentAdmin() internal {
        bytes32 pauserRole = staking.PAUSER_ROLE();
        bytes32 vaultManagerRole = staking.VAULT_MANAGER_ROLE();
        bytes32 rewardManagerRole = staking.REWARD_MANAGER_ROLE();
        bytes32 upgraderRole = staking.UPGRADER_ROLE();
        bytes32 defaultAdminRole = staking.DEFAULT_ADMIN_ROLE();

        vm.startPrank(deploymentAdmin);

        staking.renounceRole(
            pauserRole,
            deploymentAdmin
        );

        staking.renounceRole(
            vaultManagerRole,
            deploymentAdmin
        );

        staking.renounceRole(
            rewardManagerRole,
            deploymentAdmin
        );

        staking.renounceRole(
            upgraderRole,
            deploymentAdmin
        );

        staking.renounceRole(
            defaultAdminRole,
            deploymentAdmin
        );

        vm.stopPrank();
    }

    function testStageTwoAcceptsCompleteStageOne() public {
        _stageOne();

        assertTrue(
            finalizer.verifyStageOne(_config())
        );
    }

    function testStageTwoRejectsIncompleteStageOne() public view {
        assertFalse(
            finalizer.verifyStageOne(_config())
        );
    }

    function testStageTwoRejectsWrongTimelockDelay() public {
        _stageOne();

        FinalizeArvoGovernance.GovernanceConfig memory config =
            _config();

        config.timelockDelay = DELAY + 1 hours;

        assertFalse(
            finalizer.verifyStageOne(config)
        );
    }

    function testStageTwoRejectsWrongGovernanceSafe() public {
        _stageOne();

        FinalizeArvoGovernance.GovernanceConfig memory config =
            _config();

        config.governanceSafe = outsider;

        assertFalse(
            finalizer.verifyStageOne(config)
        );
    }

    function testFinalTopologyRemovesAllDeploymentAdminRoles() public {
        _stageOne();

        assertTrue(
            finalizer.verifyStageOne(_config())
        );

        _renounceDeploymentAdmin();

        assertTrue(
            finalizer.verifyFinalTopology(_config())
        );

        assertFalse(
            staking.hasRole(
                staking.DEFAULT_ADMIN_ROLE(),
                deploymentAdmin
            )
        );

        assertFalse(
            staking.hasRole(
                staking.UPGRADER_ROLE(),
                deploymentAdmin
            )
        );

        assertFalse(
            staking.hasRole(
                staking.VAULT_MANAGER_ROLE(),
                deploymentAdmin
            )
        );

        assertFalse(
            staking.hasRole(
                staking.REWARD_MANAGER_ROLE(),
                deploymentAdmin
            )
        );

        assertFalse(
            staking.hasRole(
                staking.PAUSER_ROLE(),
                deploymentAdmin
            )
        );
    }

    function testFinalTopologyPreservesDestinationAuthorities() public {
        _stageOne();
        _renounceDeploymentAdmin();

        assertTrue(
            staking.hasRole(
                staking.DEFAULT_ADMIN_ROLE(),
                address(timelock)
            )
        );

        assertTrue(
            staking.hasRole(
                staking.UPGRADER_ROLE(),
                address(timelock)
            )
        );

        assertTrue(
            staking.hasRole(
                staking.VAULT_MANAGER_ROLE(),
                safe
            )
        );

        assertTrue(
            staking.hasRole(
                staking.REWARD_MANAGER_ROLE(),
                safe
            )
        );

        assertTrue(
            staking.hasRole(
                staking.PAUSER_ROLE(),
                emergency
            )
        );

        assertTrue(
            finalizer.verifyFinalTopology(_config())
        );
    }

    function testFinalVerifierRejectsResidualDeploymentRole() public {
        _stageOne();

        bytes32 pauserRole = staking.PAUSER_ROLE();
        bytes32 vaultManagerRole = staking.VAULT_MANAGER_ROLE();
        bytes32 rewardManagerRole = staking.REWARD_MANAGER_ROLE();
        bytes32 upgraderRole = staking.UPGRADER_ROLE();

        vm.startPrank(deploymentAdmin);

        staking.renounceRole(
            pauserRole,
            deploymentAdmin
        );

        staking.renounceRole(
            vaultManagerRole,
            deploymentAdmin
        );

        staking.renounceRole(
            rewardManagerRole,
            deploymentAdmin
        );

        staking.renounceRole(
            upgraderRole,
            deploymentAdmin
        );

        /*
         * DEFAULT_ADMIN deliberately left behind.
         */
        vm.stopPrank();

        assertFalse(
            finalizer.verifyFinalTopology(_config())
        );
    }
}
