pragma solidity ^0.8.24;

import { Test } from "forge-std/Test.sol";
import { TimelockController } from "@openzeppelin/contracts/governance/TimelockController.sol";
import { ERC1967Proxy } from "@openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol";
import { Upgrades } from "openzeppelin-foundry-upgrades/Upgrades.sol";

import { ArvoStaking } from "../../src/ArvoStaking.sol";
import { MockERC20 } from "../../src/mocks/MockERC20.sol";
import { ArvoStakingV2 } from "../upgrade/mocks/ArvoStakingV2.sol";

contract ArvoTimelockedUpgradeTest is Test {
    uint256 internal constant TIMELOCK_DELAY = 48 hours;

    address internal deployer = address(0xD3E10);
    address internal safe = address(0x5AFE);
    address internal emergency = address(0xE911);

    MockERC20 internal arvo;
    MockERC20 internal usdc;

    ArvoStaking internal staking;
    TimelockController internal timelock;

    function setUp() public {
        arvo = new MockERC20("Arvo", "ARVO", 18);

        usdc = new MockERC20("USD Coin", "USDC", 6);

        ArvoStaking implementation = new ArvoStaking();

        bytes memory initialization =
            abi.encodeCall(ArvoStaking.initialize, (address(arvo), address(usdc), deployer));

        ERC1967Proxy proxy = new ERC1967Proxy(address(implementation), initialization);

        staking = ArvoStaking(address(proxy));

        address[] memory proposers = new address[](1);
        proposers[0] = safe;

        address[] memory executors = new address[](1);
        executors[0] = safe;

        timelock = new TimelockController(TIMELOCK_DELAY, proposers, executors, address(0));

        _handoffGovernance();
    }

    function _handoffGovernance() internal {
        vm.startPrank(deployer);

        staking.grantRole(staking.DEFAULT_ADMIN_ROLE(), address(timelock));

        staking.grantRole(staking.UPGRADER_ROLE(), address(timelock));

        staking.grantRole(staking.VAULT_MANAGER_ROLE(), safe);

        staking.grantRole(staking.REWARD_MANAGER_ROLE(), safe);

        staking.grantRole(staking.PAUSER_ROLE(), emergency);

        staking.renounceRole(staking.PAUSER_ROLE(), deployer);

        staking.renounceRole(staking.VAULT_MANAGER_ROLE(), deployer);

        staking.renounceRole(staking.REWARD_MANAGER_ROLE(), deployer);

        staking.renounceRole(staking.UPGRADER_ROLE(), deployer);

        staking.renounceRole(staking.DEFAULT_ADMIN_ROLE(), deployer);

        vm.stopPrank();
    }

    function _upgradeData(address newImplementation) internal pure returns (bytes memory) {
        return abi.encodeCall(ArvoStaking.upgradeToAndCall, (newImplementation, bytes("")));
    }

    function testDeployerCannotUpgradeAfterHandoff() public {
        ArvoStakingV2 newImplementation = new ArvoStakingV2();

        address beforeImplementation = Upgrades.getImplementationAddress(address(staking));

        vm.prank(deployer);
        vm.expectRevert();

        staking.upgradeToAndCall(address(newImplementation), bytes(""));

        assertEq(Upgrades.getImplementationAddress(address(staking)), beforeImplementation);
    }

    function testSafeCannotUpgradeDirectly() public {
        ArvoStakingV2 newImplementation = new ArvoStakingV2();

        address beforeImplementation = Upgrades.getImplementationAddress(address(staking));

        vm.prank(safe);
        vm.expectRevert();

        staking.upgradeToAndCall(address(newImplementation), bytes(""));

        assertEq(Upgrades.getImplementationAddress(address(staking)), beforeImplementation);
    }

    function testUpgradeCannotExecuteBeforeDelay() public {
        ArvoStakingV2 newImplementation = new ArvoStakingV2();

        bytes memory data = _upgradeData(address(newImplementation));

        bytes32 predecessor = bytes32(0);

        bytes32 salt = keccak256("ARVO_TIMELOCKED_UPGRADE_EARLY");

        vm.prank(safe);

        timelock.schedule(address(staking), 0, data, predecessor, salt, TIMELOCK_DELAY);

        vm.prank(safe);
        vm.expectRevert();

        timelock.execute(address(staking), 0, data, predecessor, salt);

        assertEq(ArvoStakingV2(address(staking)).version(), 0);
    }

    function testTimelockedUpgradeSucceedsAfterDelay() public {
        ArvoStakingV2 newImplementation = new ArvoStakingV2();

        address implementationBefore = Upgrades.getImplementationAddress(address(staking));

        bytes memory data = _upgradeData(address(newImplementation));

        bytes32 predecessor = bytes32(0);

        bytes32 salt = keccak256("ARVO_TIMELOCKED_UPGRADE_SUCCESS");

        vm.prank(safe);

        timelock.schedule(address(staking), 0, data, predecessor, salt, TIMELOCK_DELAY);

        vm.warp(block.timestamp + TIMELOCK_DELAY);

        vm.prank(safe);

        timelock.execute(address(staking), 0, data, predecessor, salt);

        address implementationAfter = Upgrades.getImplementationAddress(address(staking));

        assertTrue(implementationAfter != implementationBefore);

        assertEq(implementationAfter, address(newImplementation));

        ArvoStakingV2 upgraded = ArvoStakingV2(address(staking));

        assertEq(upgraded.version(), 2);

        // Existing proxy state survives.
        assertEq(address(upgraded.arvo()), address(arvo));

        assertEq(address(upgraded.usdc()), address(usdc));

        // Governance topology survives.
        assertTrue(upgraded.hasRole(upgraded.DEFAULT_ADMIN_ROLE(), address(timelock)));

        assertTrue(upgraded.hasRole(upgraded.UPGRADER_ROLE(), address(timelock)));

        assertTrue(upgraded.hasRole(upgraded.VAULT_MANAGER_ROLE(), safe));

        assertTrue(upgraded.hasRole(upgraded.REWARD_MANAGER_ROLE(), safe));

        assertTrue(upgraded.hasRole(upgraded.PAUSER_ROLE(), emergency));

        assertFalse(upgraded.hasRole(upgraded.UPGRADER_ROLE(), deployer));
    }

    function testOnlySafeCanScheduleUpgrade() public {
        ArvoStakingV2 newImplementation = new ArvoStakingV2();

        bytes memory data = _upgradeData(address(newImplementation));

        vm.prank(deployer);
        vm.expectRevert();

        timelock.schedule(
            address(staking),
            0,
            data,
            bytes32(0),
            keccak256("DEPLOYER_CANNOT_SCHEDULE"),
            TIMELOCK_DELAY
        );
    }
}
