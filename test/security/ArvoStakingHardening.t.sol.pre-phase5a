// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import { Test } from "forge-std/Test.sol";

import { ERC1967Proxy } from "@openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol";

import { ArvoStaking } from "../../src/ArvoStaking.sol";
import { ArvoStakingTypes } from "../../src/ArvoStakingTypes.sol";
import { ArvoVaultDefaults } from "../../src/ArvoVaultDefaults.sol";
import { MockERC20 } from "../../src/mocks/MockERC20.sol";
import { MockFeeToken } from "../../src/mocks/MockFeeToken.sol";

contract ArvoStakingHardeningTest is Test {
    address internal admin = address(0xA11CE);
    address internal user = address(0xB0B);

    function _deploy(address arvoToken, address usdcToken) internal returns (ArvoStaking staking) {
        ArvoStaking implementation = new ArvoStaking();

        ERC1967Proxy proxy = new ERC1967Proxy(
            address(implementation),
            abi.encodeCall(ArvoStaking.initialize, (arvoToken, usdcToken, admin))
        );

        staking = ArvoStaking(address(proxy));
    }

    function testRejectsSameTokenForArvoAndUsdc() public {
        MockERC20 token = new MockERC20("Token", "TOKEN", 18);

        ArvoStaking implementation = new ArvoStaking();

        vm.expectRevert(ArvoStaking.InvalidConfiguration.selector);

        new ERC1967Proxy(
            address(implementation),
            abi.encodeCall(ArvoStaking.initialize, (address(token), address(token), admin))
        );
    }

    function testRejectsEOAAsTokenAddress() public {
        MockERC20 usdc = new MockERC20("USD Coin", "USDC", 6);

        ArvoStaking implementation = new ArvoStaking();

        vm.expectRevert(ArvoStaking.InvalidConfiguration.selector);

        new ERC1967Proxy(
            address(implementation),
            abi.encodeCall(ArvoStaking.initialize, (address(0x1234), address(usdc), admin))
        );
    }

    function testRejectsFeeOnTransferPrincipal() public {
        MockFeeToken arvo = new MockFeeToken();

        MockERC20 usdc = new MockERC20("USD Coin", "USDC", 6);

        ArvoStaking staking = _deploy(address(arvo), address(usdc));

        /*
         * Seed reward capacity directly because funding with the
         * fee-on-transfer token is itself correctly rejected.
         */
        arvo.mint(address(staking), 1_000_000 ether);

        vm.startPrank(admin);

        uint32 poolId = staking.createStandardPool(
            ArvoStakingTypes.VaultKind.FOUNDATION,
            uint64(block.timestamp + 1),
            0,
            0,
            0,
            true,
            false,
            false,
            true,
            false
        );

        staking.reservePoolRewardBudget(poolId, 100_000 ether, 0);

        vm.stopPrank();

        arvo.mint(user, 10_000 ether);

        vm.warp(block.timestamp + 1);

        vm.startPrank(user);

        arvo.approve(address(staking), type(uint256).max);

        vm.expectRevert(ArvoStaking.UnexpectedTokenTransfer.selector);

        staking.stake(
            poolId,
            ArvoStakingTypes.StakeMode.ARVO,
            ArvoStakingTypes.RewardMode.ARVO,
            10_000 ether,
            0
        );

        vm.stopPrank();

        assertEq(staking.arvoPrincipalLiability(), 0);

        assertEq(staking.arvoRewardLiability(), 0);
    }

    function testRejectsFeeOnTransferRewardFunding() public {
        MockFeeToken arvo = new MockFeeToken();

        MockERC20 usdc = new MockERC20("USD Coin", "USDC", 6);

        ArvoStaking staking = _deploy(address(arvo), address(usdc));

        arvo.mint(admin, 10_000 ether);

        vm.startPrank(admin);

        arvo.approve(address(staking), type(uint256).max);

        vm.expectRevert(ArvoStaking.UnexpectedTokenTransfer.selector);

        staking.fundArvoRewards(10_000 ether);

        vm.stopPrank();

        assertEq(arvo.balanceOf(address(staking)), 0);
    }

    function testRejectsDualBoostAboveCombinedCap() public {
        MockERC20 arvo = new MockERC20("Arvo", "ARVO", 18);

        MockERC20 usdc = new MockERC20("USD Coin", "USDC", 6);

        ArvoStaking staking = _deploy(address(arvo), address(usdc));

        ArvoStakingTypes.VaultConfig memory config = ArvoVaultDefaults.foundation();

        config.dualBoostBps = 2_000;
        config.combinedBoostCapBps = 1_000;

        vm.prank(admin);

        vm.expectRevert(ArvoStaking.InvalidConfiguration.selector);

        staking.createCustomPool(config, uint64(block.timestamp + 1), 0, 0, 0);
    }

    function testRejectsRewardRateAboveOneHundredPercent() public {
        MockERC20 arvo = new MockERC20("Arvo", "ARVO", 18);

        MockERC20 usdc = new MockERC20("USD Coin", "USDC", 6);

        ArvoStaking staking = _deploy(address(arvo), address(usdc));

        ArvoStakingTypes.VaultConfig memory config = ArvoVaultDefaults.foundation();

        config.arvoRewardBps = 10_001;

        vm.prank(admin);

        vm.expectRevert(ArvoStaking.InvalidConfiguration.selector);

        staking.createCustomPool(config, uint64(block.timestamp + 1), 0, 0, 0);
    }
}
